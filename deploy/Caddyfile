{$COMMUNITY_DOMAIN} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        -Server
    }

    @api path /api/*
    handle @api {
        reverse_proxy api:8080
    }
    handle {
        root * /srv
        file_server
    }
}
